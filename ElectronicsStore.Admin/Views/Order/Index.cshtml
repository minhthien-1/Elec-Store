@model List<ElectronicsStore.API.Models.Entities.DonHang>
@{
    ViewData["Title"] = "Quản Lý Đơn Hàng";
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
}

<!-- Stats -->
<div class="row">
    <div class="col-md-4">
        <div class="stats-card">
            <div class="d-flex align-items-center">
                <div class="stats-icon" style="background: linear-gradient(135deg, #FF8C42, #FF6B35);">
                    <i class="fas fa-shopping-cart"></i>
                </div>
                <div class="ms-3">
                    <div class="text-muted" style="font-size:0.8rem;">Tổng Đơn Hàng</div>
                    <div style="font-size:1.6rem; font-weight:700;">@Model.Count</div>
                </div>
            </div>
        </div>
    </div>
    <div class="col-md-4">
        <div class="stats-card">
            <div class="d-flex align-items-center">
                <div class="stats-icon" style="background: linear-gradient(135deg, #f093fb, #f5576c);">
                    <i class="fas fa-clock"></i>
                </div>
                <div class="ms-3">
                    <div class="text-muted" style="font-size:0.8rem;">Chờ Xác Nhận</div>
                    <div style="font-size:1.6rem; font-weight:700;">@Model.Count(o => o.TrangThaiDon == "Chờ xác nhận")</div>
                </div>
            </div>
        </div>
    </div>
    <div class="col-md-4">
        <div class="stats-card">
            <div class="d-flex align-items-center">
                <div class="stats-icon" style="background: linear-gradient(135deg, #4facfe, #00f2fe);">
                    <i class="fas fa-check-double"></i>
                </div>
                <div class="ms-3">
                    <div class="text-muted" style="font-size:0.8rem;">Hoàn Thành</div>
                    <div style="font-size:1.6rem; font-weight:700;">@Model.Count(o => o.TrangThaiDon == "Hoàn thành")</div>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Table Card -->
<div class="table-card">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h5 class="fw-bold mb-0" style="color:#2d3748;">
            <i class="fas fa-list-alt me-2" style="color:#FF8C42;"></i>Danh Sách Đơn Hàng
        </h5>
        <button class="btn btn-orange" onclick="location.reload();">
            <i class="fas fa-sync-alt me-1"></i> Làm mới dữ liệu
        </button>
    </div>

    <div class="table-responsive">
        <table class="table table-hover align-middle" id="orderTable">
            <thead>
                <tr>
                    <th>Mã Đơn</th>
                    <th>Khách Hàng</th>
                    <th>Ngày Đặt</th>
                    <th>Tổng Tiền</th>
                    <th>Thanh Toán</th>
                    <th>Trạng Thái</th>
                    <th class="text-center">Thao Tác</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var order in Model)
                {
                    <tr>
                        <td><strong>#@order.MaDH</strong></td>
                        <td>
                            <div class="d-flex flex-column">
                                <strong class="text-dark">@(order.NguoiDung?.TenDayDu ?? "Khách hàng")</strong>
                                <small class="text-muted"><i class="fas fa-phone-alt me-1" style="font-size: 0.7rem;"></i>@(order.SodTLienHe ?? order.NguoiDung?.SoDienThoai ?? "N/A")</small>
                            </div>
                        </td>
                        <td>
                            @order.NgayTaoDon.ToString("dd/MM/yyyy")<br/>
                            <small class="text-muted">@order.NgayTaoDon.ToString("HH:mm")</small>
                        </td>
                        <td><strong class="text-danger">@order.TongGiaSauGiam.ToString("N0") VNĐ</strong></td>
                        <td>
                            <span class="badge bg-light text-dark border d-block mb-1">@(order.PhuongThucThanhToan ?? "N/A")</span>
                            <small class="text-muted">@order.TrangThaiThanhToan</small>
                        </td>
                        <td>
                            @{
                                string badgeClass = order.TrangThaiDon switch
                                {
                                    "Chờ xác nhận" => "bg-warning text-dark",
                                    "Đang giao hàng" => "bg-info text-white",
                                    "Hoàn thành" => "bg-success",
                                    "Đã hủy" => "bg-danger",
                                    _ => "bg-secondary"
                                };
                            }
                            <span class="badge @badgeClass" style="padding:6px 12px; font-size: 0.8rem;" id="status-badge-@order.MaDH">
                                @order.TrangThaiDon
                            </span>
                        </td>
                        <td class="text-center">
                            @if (order.TrangThaiDon == "Chờ xác nhận")
                            {
                                <button onclick="updateStatus(@order.MaDH, 'Đang giao hàng')" class="btn btn-sm btn-primary me-1" title="Duyệt đơn hàng">
                                    <i class="fas fa-truck"></i>
                                </button>
                                <button onclick="updateStatus(@order.MaDH, 'Đã hủy')" class="btn btn-sm btn-danger" title="Hủy đơn hàng">
                                    <i class="fas fa-times"></i>
                                </button>
                            }
                            else if (order.TrangThaiDon == "Đang giao hàng")
                            {
                                <button onclick="updateStatus(@order.MaDH, 'Hoàn thành')" class="btn btn-sm btn-success" title="Xác nhận hoàn thành">
                                    <i class="fas fa-check"></i>
                                </button>
                            }
                            else
                            {
                                <button class="btn btn-sm btn-light border" disabled title="Không có hành động">
                                    <i class="fas fa-ban text-muted"></i>
                                </button>
                            }
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>

<!-- Status Update Modal -->
<div class="modal fade" id="statusModal" tabindex="-1">
    <div class="modal-dialog">
        <div class="modal-content border-0 shadow">
            <div class="modal-header border-0 pb-0">
                <h5 class="modal-title fw-bold text-primary" id="modalTitle">Xác Nhận</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body">
                <p>Bạn có chắc chắn muốn chuyển trạng thái đơn <strong id="orderIdText" class="text-dark"></strong> thành <strong id="newStatusText" class="text-primary"></strong>?</p>
            </div>
            <div class="modal-footer border-0 pt-0">
                <button class="btn btn-light border" data-bs-dismiss="modal">Hủy</button>
                <button class="btn btn-primary px-4" id="confirmUpdate">Đồng ý</button>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        $(document).ready(function () {
            $('#orderTable').DataTable({
                language: { url: '//cdn.datatables.net/plug-ins/1.13.6/i18n/vi.json' },
                pageLength: 10,
                order: [[0, 'desc']]
            });
        });

        let currentOrderId = null;
        let currentNewStatus = null;
        const statusModal = new bootstrap.Modal(document.getElementById('statusModal'));

        function updateStatus(orderId, newStatus) {
            currentOrderId = orderId;
            currentNewStatus = newStatus;
            
            document.getElementById('orderIdText').textContent = '#' + orderId;
            document.getElementById('newStatusText').textContent = newStatus;
            
            // Đổi màu chữ theo trạng thái cho đẹp
            const statusEl = document.getElementById('newStatusText');
            statusEl.className = newStatus === 'Đã hủy' ? 'text-danger' : 
                                 newStatus === 'Hoàn thành' ? 'text-success' : 'text-info';
                                 
            statusModal.show();
        }

        document.getElementById('confirmUpdate').addEventListener('click', async function () {
            if (!currentOrderId || !currentNewStatus) return;
            
            const btn = this;
            const originalText = btn.innerHTML;
            btn.innerHTML = '<span class="spinner-border spinner-border-sm"></span> Đang xử lý...';
            btn.disabled = true;

            try {
                const response = await fetch('@Url.Action("UpdateStatus", "Order")', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({ orderId: currentOrderId, newStatus: currentNewStatus })
                });
                
                const result = await response.json();
                if (result.success) {
                    statusModal.hide();
                    // Hiển thị thông báo Toast hoặc Reload
                    location.reload(); 
                } else {
                    alert('Lỗi: ' + result.message);
                }
            } catch (error) {
                alert('Có lỗi xảy ra: ' + error);
            } finally {
                btn.innerHTML = originalText;
                btn.disabled = false;
            }
        });
    </script>
}
