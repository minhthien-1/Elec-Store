@model List<ElectronicsStore.API.Models.Entities.SanPham>

<div class="dropdown me-3">
    <button class="btn btn-light position-relative border-0 rounded-circle" style="width: 40px; height: 40px; background-color: #f8f9fa;" type="button" data-bs-toggle="dropdown" aria-expanded="false">
        <i class="fas fa-bell" style="color: #4a5568;"></i>
        @if (Model.Any())
        {
            <span class="position-absolute top-0 start-100 translate-middle badge rounded-pill bg-danger border border-light" style="font-size: 0.65rem;">
                @Model.Count
                <span class="visually-hidden">cảnh báo</span>
            </span>
        }
    </button>
    <ul class="dropdown-menu dropdown-menu-end shadow-lg border-0" style="width: 340px; border-radius: 12px; padding: 0;">
        <li class="p-3 border-bottom rounded-top" style="background-color: #fff5f5; border-radius: 12px 12px 0 0;">
            <h6 class="mb-0 fw-bold text-danger"><i class="fas fa-exclamation-triangle me-2"></i>Cảnh báo tồn kho (Dưới 5 SP)</h6>
        </li>
        @if (Model.Any())
        {
            foreach (var item in Model)
            {
                <li>
                    <a class="dropdown-item py-3 border-bottom d-flex align-items-center" href="/Product/Edit/@item.MaSP" style="white-space: normal;">
                        <img src="@item.HinhAnh" class="rounded me-3 border" width="45" height="45" style="object-fit: cover;" onerror="this.src='https://via.placeholder.com/45'">
                        <div class="flex-grow-1 overflow-hidden">
                            <h6 class="mb-1 fw-bold text-dark" style="font-size: 0.9rem; line-height: 1.2;">@item.TenSP</h6>
                            <small class="text-danger fw-bold"><i class="fas fa-box-open me-1"></i>Chỉ còn @item.SoLuongTonKho chiếc</small>
                        </div>
                    </a>
                </li>
            }
            <li>
                <a class="dropdown-item text-center text-primary py-3 fw-bold" href="/Product" style="font-size: 0.9rem; border-radius: 0 0 12px 12px;">
                    <i class="fas fa-arrow-right me-1"></i> Đến trang Quản lý sản phẩm
                </a>
            </li>
        }
        else
        {
            <li>
                <div class="dropdown-item text-muted text-center py-4">
                    <i class="fas fa-check-circle text-success fs-3 mb-2 d-block"></i>
                    Kho hàng đang ở trạng thái an toàn
                </div>
            </li>
        }
    </ul>
</div>
