@using Microsoft.Extensions.DependencyInjection
@inject IServiceProvider ServiceProvider
@inject NavigationManager NavManager

<div class="search w-50 mx-4 position-relative">
    <input type="text"
           placeholder="Bạn tìm gì hôm nay?"
           class="form-control search-input"
           @bind="SearchTerm"
           @bind:event="oninput" 
           @onfocus="ShowResults"
           @onblur="HideResults" />
           
    @if (IsShowing && Results.Any())
    {
        <ul class="list-group position-absolute w-100 mt-1 shadow" style="z-index: 1000; border-radius: 12px; overflow: hidden; max-height: 400px; overflow-y: auto;">
            @foreach (var p in Results)
            {
                <li class="list-group-item list-group-item-action d-flex align-items-center"
                    style="cursor: pointer;"
                    @onmousedown="() => NavigateTo(p.MaSP)">
                    <img src="@p.HinhAnh" alt="@p.TenSP" style="width: 40px; height: 40px; object-fit: contain; margin-right: 15px;" />
                    <div>
                        <div class="fw-bold" style="font-size: 0.95rem;">@p.TenSP</div>
                        <div class="text-danger fw-semibold" style="font-size: 0.85rem;">@p.GiaBan.ToString("N0")₫</div>
                    </div>
                </li>
            }
        </ul>
    }
</div>

@code {
    private string _searchTerm = "";
    public string SearchTerm
    {
        get => _searchTerm;
        set
        {
            if (_searchTerm != value)
            {
                _searchTerm = value;
                InvokeAsync(SearchProducts);
            }
        }
    }

    private List<SanPham> Results = new List<SanPham>();
    private bool IsShowing = false;

    private async Task SearchProducts()
    {
        if (string.IsNullOrWhiteSpace(_searchTerm))
        {
            Results.Clear();
            IsShowing = false;
            StateHasChanged();
            return;
        }

        using var scope = ServiceProvider.CreateScope();
        var db = scope.ServiceProvider.GetRequiredService<ElectronicsStoreDbContext>();

        string term = _searchTerm.ToLower();
        // Giới hạn 5 kết quả
        Results = await db.SanPhams
            .Where(p => p.TenSP.ToLower().Contains(term) && p.TrangThai == true)
            .Take(5)
            .ToListAsync();
            
        IsShowing = true;
        StateHasChanged();
    }

    private void ShowResults()
    {
        if (Results.Any())
        {
            IsShowing = true;
        }
    }

    // Delay một chút để kịp bắt event click chuột (mousedown) trước khi blur
    private async Task HideResults()
    {
        await Task.Delay(200);
        IsShowing = false;
        StateHasChanged();
    }

    private void NavigateTo(int id)
    {
        // Chuyển hướng đến chi tiết SP bằng URL gốc của MVC
        NavManager.NavigateTo($"/Product/Details/{id}", forceLoad: true);
    }
}
