@{
    ViewData["Title"] = "Thanh toán thất bại";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="container py-5 text-center">
    <div class="card border-0 shadow-sm p-5 mx-auto" style="max-width: 600px; border-radius: 20px;">
        <div class="mb-4">
            <i class="bi bi-x-circle-fill text-danger" style="font-size: 5rem;"></i>
        </div>

        <h2 class="fw-bold text-danger mb-3">Thanh toán không thành công!</h2>

        <p class="text-muted mb-4">
            Giao dịch đã bị hủy hoặc có lỗi xảy ra trong quá trình thanh toán.<br>
            Vui lòng kiểm tra lại hoặc chọn phương thức thanh toán khác.
        </p>

        @if (ViewBag.Message != null)
        {
            <div class="alert alert-warning">
                @ViewBag.Message
            </div>
        }

        <div class="d-flex justify-content-center gap-3">
            <a href="/" class="btn btn-outline-secondary px-4 py-2">
                Về trang chủ
            </a>
            <a href="/Checkout" class="btn btn-danger px-4 py-2">
                Thử thanh toán lại
            </a>
        </div>
    </div>
</div>