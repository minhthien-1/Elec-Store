@model ElectronicsStore.Customer.Models.CheckoutViewModel
@{
    ViewData["Title"] = "Thanh toán";
    Layout = "~/Views/Shared/_Layout.cshtml";
    var vouchers = ViewBag.Vouchers as List<ElectronicsStore.Customer.Controllers.VoucherViewModel>
        ?? new List<ElectronicsStore.Customer.Controllers.VoucherViewModel>();
}

<style>
    .checkout-product-list { padding: 10px 10px 0 0; }
    .checkout-item-img-wrapper { margin-right: 15px !important; overflow: visible !important; position: relative; }
    .qty-badge-custom { width: 24px; height: 24px; display: flex; align-items: center; justify-content: center; font-size: 12px !important; font-weight: 700; padding: 0 !important; top: -8px; right: -8px; }
    .btn-checkout-confirm { background: linear-gradient(180deg, #ff424e, #e31837); color: white; border: none; padding: 15px; border-radius: 8px; font-weight: 800; font-size: 1.3rem; text-transform: uppercase; width: 100%; box-shadow: 0 4px 6px rgba(227,24,55,0.2); transition: all 0.3s ease; }
    .btn-checkout-confirm:hover { background: linear-gradient(180deg, #e31837, #ff424e); transform: translateY(-2px); color: white; }
    .payment-option-card { cursor: pointer; transition: all 0.2s; border: 2px solid #eee; border-radius: 8px; }
    .payment-option-card.selected { border-color: #e31837 !important; background-color: #fff5f6 !important; }
    .voucher-box { background: #fff8f0; border: 1.5px dashed #ff6600; border-radius: 8px; padding: 14px 16px; }
    .voucher-saving { color: #43a047; font-size: 0.9rem; }
</style>

<div class="container py-5">
    <form asp-action="PlaceOrder" method="post" id="checkoutForm">
        <div class="row">
            <div class="col-md-7">
                <div class="card shadow-sm border-0 mb-4">
                    <div class="card-header bg-white py-3">
                        <h5 class="mb-0 fw-bold text-danger"><i class="bi bi-geo-alt-fill me-2"></i>Thông tin giao hàng</h5>
                    </div>
                    <div class="card-body">
                        <div class="row g-3">
                            <div class="col-md-6">
                                <label class="form-label small text-muted">Họ và tên</label>
                                <input asp-for="HoTen" class="form-control" required placeholder="Nhập họ tên người nhận">
                            </div>
                            <div class="col-md-6">
                                <label class="form-label small text-muted">Số điện thoại</label>
                                <input asp-for="SoDienThoai" class="form-control" required placeholder="Nhập số điện thoại">
                            </div>
                            <div class="col-12">
                                <label class="form-label small text-muted">Email (để nhận hóa đơn)</label>
                                <input asp-for="Email" class="form-control" type="email">
                            </div>
                            <div class="col-md-4">
                                <label class="form-label small text-muted">Tỉnh / Thành</label>
                                <select class="form-select" id="province" required>
                                    <option value="">Chọn Tỉnh/Thành</option>
                                </select>
                                <input type="hidden" asp-for="TinhThanh" id="provinceName" />
                            </div>
                            <div class="col-md-4">
                                <label class="form-label small text-muted">Quận / Huyện</label>
                                <select class="form-select" id="district" required>
                                    <option value="">Chọn Quận/Huyện</option>
                                </select>
                                <input type="hidden" asp-for="QuanHuyen" id="districtName" />
                            </div>
                            <div class="col-md-4">
                                <label class="form-label small text-muted">Phường / Xã</label>
                                <select class="form-select" id="ward" required>
                                    <option value="">Chọn Phường/Xã</option>
                                </select>
                                <input type="hidden" asp-for="PhuongXa" id="wardName" />
                            </div>
                            <div class="col-12">
                                <label class="form-label small text-muted">Địa chỉ cụ thể</label>
                                <input asp-for="DiaChiCuThe" class="form-control" required placeholder="Số nhà, tên đường, tòa nhà...">
                            </div>
                            <div class="col-12">
                                <label class="form-label small text-muted">Ghi chú đơn hàng</label>
                                <textarea asp-for="GhiChu" class="form-control" rows="2" placeholder="Ví dụ: Giao giờ hành chính..."></textarea>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <div class="col-md-5">
                <div class="card shadow-sm border-0">
                    <div class="card-header bg-white py-3">
                        <h5 class="mb-0 fw-bold"><i class="bi bi-receipt me-2"></i>Đơn hàng của bạn</h5>
                    </div>
                    <div class="card-body">

                        <div class="checkout-product-list mb-3" style="max-height: 300px; overflow-y: auto; overflow-x: visible;">
                            @foreach (var item in Model.CartItems)
                            {
                                <div class="d-flex justify-content-between align-items-center mb-3 border-bottom pb-2">
                                    <div class="d-flex align-items-center" style="max-width: 80%;">
                                        <div class="checkout-item-img-wrapper">
                                            <img src="@item.SanPham.HinhAnh" width="60" height="60"
                                                 style="object-fit:cover;" class="rounded border bg-white"
                                                 onerror="this.src='https://via.placeholder.com/60'">
                                            <span class="position-absolute badge rounded-pill bg-danger border border-white qty-badge-custom">
                                                @item.SoLuong
                                            </span>
                                        </div>
                                        <div class="ms-2">
                                            <span class="small fw-bold text-break"
                                                  style="display:-webkit-box; -webkit-line-clamp:2; -webkit-box-orient:vertical; overflow:hidden;">
                                                @item.SanPham.TenSP
                                            </span>
                                        </div>
                                    </div>
                                    <span class="text-danger fw-bold small text-nowrap">
                                        @((item.SoLuong * item.SanPham.GiaBan).ToString("N0"))₫
                                    </span>
                                </div>
                            }
                        </div>

                        <div class="bg-light p-3 rounded mb-3">
                            <div class="d-flex justify-content-between mb-2">
                                <span class="text-muted">Tạm tính:</span>
                                <span class="fw-bold">@Model.TongTienHang.ToString("N0")₫</span>
                            </div>
                            <div class="d-flex justify-content-between mb-2">
                                <span class="text-muted">Phí vận chuyển:</span>
                                <span id="shippingFeeDisplay" class="@(Model.PhiVanChuyen == 0 ? "text-success fw-bold" : "")">
                                    @(Model.PhiVanChuyen == 0 ? "Miễn phí" : Model.PhiVanChuyen.ToString("N0") + "₫")
                                </span>
                            </div>
                            <div class="d-flex justify-content-between mb-2" id="voucherDiscountRow" style="display:none !important;">
                                <span class="text-muted">Giảm giá voucher:</span>
                                <span class="text-success fw-bold" id="voucherDiscountAmount">-0₫</span>
                            </div>
                            <hr>
                            <div class="d-flex justify-content-between align-items-center">
                                <span class="fw-bold fs-5">Tổng cộng:</span>
                                <span class="fw-bold fs-3 text-danger" id="tongThanhToanDisplay">
                                    @Model.TongThanhToan.ToString("N0")₫
                                </span>
                            </div>
                        </div>

                        <div class="voucher-box mb-4">
                            <div class="d-flex align-items-center mb-2">
                                <i class="bi bi-tag-fill text-warning me-2"></i>
                                <span class="fw-semibold">Mã giảm giá</span>
                            </div>
                            @if (vouchers.Any())
                            {
                                <div class="d-flex gap-2 flex-wrap">
                                    <select id="voucherSelect" class="form-select form-select-sm flex-grow-1"
                                            style="border:1px solid #ff6600; border-radius:6px;">
                                        <option value="">-- Chọn mã giảm giá --</option>
                                        @foreach (var v in vouchers)
                                        {
                                            var moTaGiam = v.kieuGiam == "PhanTram"
                                                ? $"Giảm {v.giaTriGiam}%{(v.giaTriGiamToiDa.HasValue ? $" (tối đa {v.giaTriGiamToiDa:N0}đ)" : "")}"
                                                : $"Giảm {v.giaTriGiam:N0}đ";
                                            <option value="@v.maCode">
                                                [@v.maCode] @moTaGiam
                                                @if (v.giaTriDonHangToiThieu.HasValue)
                                                { @($" | Đơn từ {v.giaTriDonHangToiThieu:N0}đ") }
                                            </option>
                                        }
                                    </select>
                                    <button type="button" onclick="applyVoucher()"
                                            class="btn btn-warning btn-sm fw-semibold px-3">
                                        <i class="bi bi-lightning-fill me-1"></i>Áp dụng
                                    </button>
                                    <button type="button" onclick="removeVoucher()" id="btnRemoveVoucher"
                                            class="btn btn-outline-secondary btn-sm" style="display:none;">
                                        Bỏ mã
                                    </button>
                                </div>
                                <div id="voucherError" class="text-danger small mt-1" style="display:none;"></div>
                                <div id="voucherSuccess" class="voucher-saving mt-1" style="display:none;">
                                    <i class="bi bi-check-circle-fill me-1"></i>
                                    Tiết kiệm: <strong id="discountDisplay"></strong>
                                    <span class="ms-1 text-muted" id="voucherMessage"></span>
                                </div>
                            }
                            else
                            {
                                <p class="text-muted small mb-0">Hiện không có mã giảm giá khả dụng.</p>
                            }
                        </div>

                        <input type="hidden" asp-for="TongTienHang" />
                        <input type="hidden" asp-for="PhiVanChuyen" />
                        <input type="hidden" id="appliedVoucherCode" name="AppliedVoucherCode" value="" />
                        <input type="hidden" id="appliedDiscount" name="AppliedDiscount" value="0" />
                        <input type="hidden" id="selectedPayment" asp-for="HinhThucThanhToan" value="COD" />

                        <div class="mt-2">
                            <h6 class="fw-bold mb-3">Chọn hình thức thanh toán:</h6>

                            <div class="mb-2">
                                <div class="d-flex align-items-center p-3 payment-option-card selected"
                                     id="lblCOD" onclick="selectPayment('COD')">
                                    <div style="width:40px; text-align:center; font-size:1.4rem; flex-shrink:0;">
                                        <i class="bi bi-cash-coin text-success"></i>
                                    </div>
                                    <span class="fw-semibold ms-2">Thanh toán tiền mặt khi nhận hàng (COD)</span>
                                </div>
                            </div>

                            <div>
                                <div class="d-flex align-items-center p-3 payment-option-card"
                                     id="lblVNPAY" onclick="selectPayment('VNPAY')">
                                    <div style="width:40px; text-align:center; flex-shrink:0;">
                                        <img src="https://cdn.haitrieu.com/wp-content/uploads/2022/10/Icon-VNPAY-QR.png" height="28" alt="VNPay">
                                    </div>
                                    <span class="fw-semibold ms-2">Thanh toán online qua VNPAY (ATM/QR)</span>
                                </div>
                            </div>
                        </div>

                        <button type="submit" class="btn-checkout-confirm mt-4">ĐẶT HÀNG NGAY</button>
                    </div>
                </div>
            </div>
        </div>
    </form>
</div>

<script src="https://cdnjs.cloudflare.com/ajax/libs/jquery/3.6.0/jquery.min.js"></script>
<script>
    const tongTienHang = @Model.TongTienHang;
    let currentShippingFee = @Model.PhiVanChuyen; 
    let currentDiscount = 0; // Thêm biến toàn cục quản lý Voucher

    // Chọn phương thức thanh toán
    function selectPayment(method) {
        document.getElementById('selectedPayment').value = method;
        document.getElementById('lblCOD').classList.toggle('selected', method === 'COD');
        document.getElementById('lblVNPAY').classList.toggle('selected', method === 'VNPAY');
    }

    // --- HÀM TÍNH PHÍ SHIP MỚI ---
    async function updateShippingFee() {
        const provinceName = $("#provinceName").val();
        const districtName = $("#districtName").val();

        if (!provinceName) return;

        try {
            const res = await fetch(`/Checkout/CalculateShipping?province=${encodeURIComponent(provinceName)}&district=${encodeURIComponent(districtName)}`);
            const data = await res.json();

            if (data.success) {
                currentShippingFee = data.fee;
                
                // Sử dụng ID để target chính xác
                const shipDisplay = document.getElementById('shippingFeeDisplay');
                if (currentShippingFee === 0) {
                    shipDisplay.className = "text-success fw-bold";
                    shipDisplay.textContent = "Miễn phí";
                } else {
                    shipDisplay.className = "fw-bold";
                    shipDisplay.textContent = new Intl.NumberFormat('vi-VN').format(currentShippingFee) + '₫';
                }

                // Cập nhật Input ẩn
                document.querySelector('input[name="PhiVanChuyen"]').value = currentShippingFee;

                // Tính lại tổng cộng
                recalculateTotal();
            }
        } catch (e) {
            console.error("Lỗi tính phí ship:", e);
        }
    }

    // Hàm dùng chung để tính tổng
    function recalculateTotal() {
        const newTotal = tongTienHang + currentShippingFee - currentDiscount;
        document.getElementById('tongThanhToanDisplay').textContent = 
            new Intl.NumberFormat('vi-VN').format(newTotal) + '₫';
    }

    // Áp dụng voucher
    async function applyVoucher() {
        const maCode = document.getElementById('voucherSelect').value;
        const errDiv = document.getElementById('voucherError');
        const successDiv = document.getElementById('voucherSuccess');

        if (!maCode) {
            errDiv.textContent = 'Vui lòng chọn mã giảm giá!';
            errDiv.style.display = 'block';
            return;
        }
        errDiv.style.display = 'none';

        try {
            const res = await fetch('/Product/ApplyVoucher', {
                method: 'POST',
                headers: { 'Content-Type': 'application/x-www-form-urlencoded' },
                body: `productId=0&maCode=${encodeURIComponent(maCode)}&giaGoc=${tongTienHang}`
            });
            const data = await res.json();

            if (data.success) {
                currentDiscount = data.discount; // Đã sửa: Lưu vào biến global

                // Hiện dòng giảm giá
                document.getElementById('voucherDiscountRow').style.cssText = 'display:flex !important;';
                document.getElementById('voucherDiscountAmount').textContent =
                    '-' + new Intl.NumberFormat('vi-VN').format(data.discount) + '₫';

                // Đã sửa: Tính lại tổng dựa trên cả 2 biến
                recalculateTotal(); 

                // Thông báo tiết kiệm
                document.getElementById('discountDisplay').textContent =
                    new Intl.NumberFormat('vi-VN').format(data.discount) + '₫';
                document.getElementById('voucherMessage').textContent = data.message;
                successDiv.style.display = 'block';
                document.getElementById('btnRemoveVoucher').style.display = 'inline-block';

                // Lưu vào form
                document.getElementById('appliedVoucherCode').value = maCode;
                document.getElementById('appliedDiscount').value = data.discount;
            } else {
                errDiv.textContent = data.message;
                errDiv.style.display = 'block';
                successDiv.style.display = 'none';
            }
        } catch (e) {
            errDiv.textContent = 'Lỗi kết nối, vui lòng thử lại.';
            errDiv.style.display = 'block';
        }
    }

    function removeVoucher() {
        document.getElementById('voucherSelect').value = '';
        document.getElementById('btnRemoveVoucher').style.display = 'none';
        document.getElementById('voucherSuccess').style.display = 'none';
        document.getElementById('voucherError').style.display = 'none';
        document.getElementById('voucherDiscountRow').style.cssText = 'display:none !important;';
        document.getElementById('appliedVoucherCode').value = '';
        document.getElementById('appliedDiscount').value = '0';
        
        currentDiscount = 0; // Đã sửa: Reset biến global
        recalculateTotal(); // Đã sửa: Gọi hàm tính tổng chung
    }

    $(document).ready(function () {
        // 1. Lấy danh sách Tỉnh/Thành
        $.getJSON('https://provinces.open-api.vn/api/p/', function (data) {
            $.each(data, function (index, item) {
                $("#province").append(`<option value="${item.code}">${item.name}</option>`);
            });
        });

        // 2. Tỉnh -> Quận
        $("#province").change(function () {
            var provinceCode = $(this).val();
            $("#provinceName").val($("#province option:selected").text());

            $("#district").html('<option value="">Chọn Quận/Huyện</option>');
            $("#ward").html('<option value="">Chọn Phường/Xã</option>');

            if (provinceCode) {
                $.getJSON(`https://provinces.open-api.vn/api/p/${provinceCode}?depth=2`, function (data) {
                    $.each(data.districts, function (index, item) {
                        $("#district").append(`<option value="${item.code}">${item.name}</option>`);
                    });
                });
            }
            setTimeout(updateShippingFee, 200);
        });

        // 3. Quận -> Phường
        $("#district").change(function () {
            var districtCode = $(this).val();
            $("#districtName").val($("#district option:selected").text());

            $("#ward").html('<option value="">Chọn Phường/Xã</option>');

            if (districtCode) {
                $.getJSON(`https://provinces.open-api.vn/api/d/${districtCode}?depth=2`, function (data) {
                    $.each(data.wards, function (index, item) {
                        $("#ward").append(`<option value="${item.code}">${item.name}</option>`);
                    });
                });
            }
            // Đã sửa: Gọi update khi đổi quận/huyện
            setTimeout(updateShippingFee, 200);
        });

        // 4. Lưu tên Phường
        $("#ward").change(function () {
            $("#wardName").val($("#ward option:selected").text());
        });
    });
</script>