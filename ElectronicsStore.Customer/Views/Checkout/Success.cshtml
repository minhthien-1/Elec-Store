@{
    ViewData["Title"] = "Đặt hàng thành công";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="container py-5 text-center">
    <div class="card border-0 shadow-sm p-5 mx-auto" style="max-width: 600px; border-radius: 20px;">
        <div class="mb-4">
            <i class="bi bi-check-circle-fill text-success" style="font-size: 5rem;"></i>
        </div>

        <h2 class="fw-bold text-success mb-3">Đặt hàng thành công!</h2>

        <p class="text-muted mb-4">
            Cảm ơn bạn đã mua hàng tại <strong>Electronics Store</strong>.<br>
            Đơn hàng của bạn đang được xử lý và sẽ sớm được giao đến bạn.
        </p>

        <div class="bg-light p-3 rounded mb-4 text-start">
            <p class="mb-1"><strong>Mã đơn hàng:</strong> <span class="text-primary">#@ViewBag.OrderId</span></p>
            <p class="mb-0"><strong>Trạng thái:</strong> <span class="badge bg-success">Đã thanh toán</span></p>
        </div>

        <div class="d-flex justify-content-center gap-3">
            <a href="/" class="btn btn-danger px-5 py-2 fw-bold">
                Tiếp tục mua sắm
            </a>
        </div>
    </div>
</div>