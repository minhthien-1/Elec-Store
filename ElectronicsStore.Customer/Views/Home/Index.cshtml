@using ElectronicsStore.Customer.Models
@model IEnumerable<ProductViewModel>
@{
    ViewData["Title"] = "Trang chủ | Electronics Store";
    
    // Lấy dữ liệu từ ViewBag với ép kiểu dynamic để linh hoạt
    var categories = ViewBag.Categories as List<dynamic>;
    var categoryBrands = ViewBag.CategoryBrands as Dictionary<int, List<dynamic>>;

    // Helper: Ánh xạ Icon thông minh hơn
    string GetCategoryIcon(string name)
    {
        name = name?.ToLower() ?? "";
        if (name.Contains("laptop")) return "bi-laptop";
        if (name.Contains("điện thoại") || name.Contains("phone")) return "bi-phone";
        if (name.Contains("máy ảnh") || name.Contains("camera")) return "bi-camera";
        if (name.Contains("tai nghe") || name.Contains("audio")) return "bi-headphones";
        if (name.Contains("phụ kiện") || name.Contains("accessory")) return "bi-keyboard";
        if (name.Contains("đồng hồ") || name.Contains("watch")) return "bi-watch";
        return "bi-cpu";
    }
}

<link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap" rel="stylesheet">
<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.1/font/bootstrap-icons.css">

<style>
    :root {
        --primary-brown: #5D4037;
        --accent-red: #D32F2F;
        --soft-bg: #F8F9FA;
        --border-color: #E0E0E0;
        --modern-font: 'Inter', sans-serif;
    }

    body {
        font-family: var(--modern-font);
        background-color: #f5f5f7;
        color: #1d1d1f;
    }

    /* --- SIDEBAR & MEGA MENU --- */
    .category-sidebar {
        background: #fff;
        border-radius: 16px;
        border: 1px solid var(--border-color);
        padding: 12px 0;
        height: 100%;
    }

    .category-item {
        padding: 12px 20px;
        font-weight: 500;
        font-size: 0.95rem;
        color: #444;
        display: flex;
        align-items: center;
        justify-content: space-between;
        text-decoration: none !important;
        transition: all 0.3s ease;
    }

    .category-item:hover {
        background: #FFF5F5;
        color: var(--accent-red) !important;
        padding-left: 25px;
    }

    .group-hover-trigger { position: relative; }

    .mega-menu {
        position: absolute;
        left: 100%;
        top: 0;
        width: 650px;
        min-height: 100%;
        background: #fff;
        box-shadow: 20px 0 40px rgba(0,0,0,0.1);
        display: none;
        border-radius: 0 16px 16px 0;
        padding: 30px;
        border: 1px solid var(--border-color);
        border-left: none;
        z-index: 1100;
    }

    .group-hover-trigger:hover .mega-menu { display: block; }

    .mega-heading {
        color: var(--accent-red);
        font-weight: 700;
        text-transform: uppercase;
        font-size: 0.85rem;
        letter-spacing: 1px;
        margin-bottom: 15px;
        display: block;
        border-bottom: 2px solid #f0f0f0;
        padding-bottom: 8px;
    }

    .brand-link {
        display: block;
        color: #666;
        text-decoration: none !important;
        padding: 8px 0;
        font-size: 0.9rem;
        transition: 0.2s;
    }

    .brand-link:hover {
        color: var(--accent-red) !important;
        transform: translateX(8px);
    }

    /* --- PRODUCT CARD --- */
    .product-card {
        border-radius: 16px;
        border: 1px solid transparent;
        padding: 20px;
        height: 100%;
        transition: all 0.4s cubic-bezier(0.165, 0.84, 0.44, 1);
        background: #fff;
        display: flex;
        flex-direction: column;
    }

    .product-card:hover {
        border-color: #ffebee;
        transform: translateY(-8px);
        box-shadow: 0 15px 30px rgba(0,0,0,0.08);
    }

    .product-img-wrapper {
        height: 180px;
        display: flex;
        align-items: center;
        justify-content: center;
        margin-bottom: 15px;
        overflow: hidden;
    }

    .product-img-wrapper img {
        max-height: 100%;
        transition: transform 0.5s;
    }

    .product-card:hover .product-img-wrapper img {
        transform: scale(1.1);
    }

    .btn-buy-now {
        background-color: var(--accent-red);
        color: white;
        border: none;
        border-radius: 10px;
        padding: 10px;
        font-weight: 700;
        width: 100%;
        margin-top: auto;
        transition: 0.3s;
        opacity: 0.9;
    }

    .btn-buy-now:hover {
        background-color: #b71c1c;
        opacity: 1;
        box-shadow: 0 4px 12px rgba(211, 47, 47, 0.3);
    }

    /* --- COMMON UI --- */
    .section-heading {
        font-weight: 800;
        font-size: 1.75rem;
        color: var(--primary-brown);
        margin-bottom: 25px;
        position: relative;
    }

    .time-box {
        background: #000;
        color: #fff;
        padding: 4px 8px;
        border-radius: 6px;
        font-family: monospace;
        font-size: 1.1rem;
    }

    .cat-icon-card {
        background: #fff;
        border-radius: 15px;
        padding: 20px;
        text-align: center;
        border: 1px solid #eee;
        transition: 0.3s;
    }

    .cat-icon-card:hover {
        background: var(--accent-red);
        color: #fff !important;
        border-color: var(--accent-red);
    }

    .cat-icon-card:hover i { color: #fff !important; }

    .img-cover { object-fit: cover; }
    
    .card-link { text-decoration: none !important; color: inherit !important; }
</style>

<section class="mt-4">
    <div class="container">
        <div class="row g-3">
            <div class="col-lg-3 d-none d-lg-block">
                <div class="category-sidebar shadow-sm">
                    @if (categories != null)
                    {
                        @foreach (var cat in categories)
                        {
                            <div class="group-hover-trigger">
                                <a asp-controller="Product" asp-action="Index" asp-route-categoryId="@cat.MaDanhMuc" class="category-item">
                                    <span><i class="bi @GetCategoryIcon(cat.TenDanhMuc) me-3 fs-5"></i> @cat.TenDanhMuc</span>
                                    <i class="bi bi-chevron-right small opacity-50"></i>
                                </a>

                                <div class="mega-menu">
                                    <div class="row">
                                        <div class="col-7">
                                            <span class="mega-heading">Thương hiệu phổ biến</span>
                                            <div class="row">
                                                @if (categoryBrands != null && categoryBrands.ContainsKey(cat.MaDanhMuc))
                                                {
                                                    @foreach (var brand in categoryBrands[cat.MaDanhMuc])
                                                    {
                                                        <div class="col-6">
                                                            <a asp-controller="Product" asp-action="Index" asp-route-categoryId="@cat.MaDanhMuc" asp-route-brandId="@brand.MaNhaSX" class="brand-link">
                                                                @brand.TenNhaSX
                                                            </a>
                                                        </div>
                                                    }
                                                }
                                                else
                                                {
                                                    <div class="col-12 text-muted small">Đang cập nhật dữ liệu...</div>
                                                }
                                            </div>
                                        </div>
                                        <div class="col-5 border-start">
                                            <span class="mega-heading">Chọn theo giá</span>
                                            <a href="#" class="brand-link">Dưới 10 Triệu</a>
                                            <a href="#" class="brand-link">Từ 10 - 20 Triệu</a>
                                            <a href="#" class="brand-link">Trên 20 Triệu</a>
                                            
                                            <div class="mt-4 p-3 bg-light rounded-3">
                                                <small class="text-muted d-block mb-2">Ưu đãi hôm nay</small>
                                                <h6 class="fw-bold text-danger mb-0">Giảm đến 30% khi thanh toán qua thẻ</h6>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        }
                    }
                </div>
            </div>

            <div class="col-lg-9">
                <div id="mainCarousel" class="carousel slide shadow-sm rounded-4 overflow-hidden" data-bs-ride="carousel">
                    <div class="carousel-indicators">
                        <button type="button" data-bs-target="#mainCarousel" data-bs-slide-to="0" class="active"></button>
                        <button type="button" data-bs-target="#mainCarousel" data-bs-slide-to="1"></button>
                    </div>
                    <div class="carousel-inner" style="height: 420px;">
                        <div class="carousel-item active h-100">
                            <img src="~/images/banner_laptop.png" class="d-block w-100 h-100 img-cover" alt="Promo 1" onerror="this.src='https://via.placeholder.com/900x420?text=Săn+Sale+Laptop'">
                        </div>
                        <div class="carousel-item h-100">
                            <img src="~/images/banner_phone.png" class="d-block w-100 h-100 img-cover" alt="Promo 2" onerror="this.src='https://via.placeholder.com/900x420?text=Flash+Sale+Smartphone'">
                        </div>
                    </div>
                    <button class="carousel-control-prev" type="button" data-bs-target="#mainCarousel" data-bs-slide="prev">
                        <span class="carousel-control-prev-icon"></span>
                    </button>
                    <button class="carousel-control-next" type="button" data-bs-target="#mainCarousel" data-bs-slide="next">
                        <span class="carousel-control-next-icon"></span>
                    </button>
                </div>
            </div>
        </div>
    </div>
</section>

<section class="section-collection flashsale mt-5">
    <div class="container p-4 rounded-4 border bg-white shadow-sm">
        <div class="d-flex justify-content-between align-items-center mb-4">
            <div class="d-flex align-items-center gap-3">
                <h2 class="section-heading mb-0 text-danger"><i class="bi bi-lightning-fill"></i> FLASHSALE</h2>
                <div class="d-flex gap-2 align-items-center" id="countdown">
                    <span class="time-box" id="h">02</span> :
                    <span class="time-box" id="m">45</span> :
                    <span class="time-box" id="s">12</span>
                </div>
            </div>
            <a asp-controller="Product" asp-action="Index" class="text-danger fw-bold text-decoration-none">Xem tất cả ></a>
        </div>
        <div class="row g-4">
            @if (Model != null)
            {
                @foreach (var item in Model.OrderBy(x => Guid.NewGuid()).Take(4))
{
    <div class="col-md-3">
        <a asp-controller="Product" asp-action="Details" asp-route-id="@item.maSP" class="card-link">
            <div class="product-card text-center d-flex flex-column justify-content-between">
                <div>
                    <div class="product-img-wrapper">
                        @* Thẻ img phải đầy đủ như thế này thì dấu : sẽ hết đỏ *@
                        <img src="@item.hinhAnh" class="img-fluid mb-2" style="height: 160px; object-fit: contain;" 
                             onerror="this.src='https://via.placeholder.com/160'">
                    </div>
                    <h6 class="fw-bold text-truncate" title="@item.tenSP">@item.tenSP</h6>
                    
                    <p class="text-danger fw-bold mb-0">@item.giaBan.ToString("N0") đ</p>
                    
                    @* Sửa lỗi tính toán: dùng 1.1m (m đại diện cho decimal) *@
                    <small class="text-muted text-decoration-line-through">
                        @((item.giaBan * 1.1m).ToString("N0")) đ
                    </small>
                </div>
                <button class="btn-buy-now">MUA NGAY</button>
            </div>
        </a>
    </div>
}
            }
        </div>
    </div>
</section>

@{
    var displayCats = new List<(string Name, int Id)> {
        ("Laptop Gaming", 1),
        ("Smartphone Mới", 2),
        ("Phụ kiện Tech", 5)
    };
}

@foreach (var cat in displayCats)
{
    <section class="mt-5">
        <div class="container">
            <div class="d-flex justify-content-between align-items-end mb-4">
                <h3 class="section-heading mb-0 border-start border-danger border-4 ps-3">@cat.Name</h3>
                <a asp-controller="Product" asp-action="Index" asp-route-categoryId="@cat.Id" class="text-decoration-none text-muted small">Khám phá thêm <i class="bi bi-arrow-right"></i></a>
            </div>
            <div class="row g-4">
                @{
                    var prods = Model?.Where(p => p.maDanhMuc == cat.Id).Take(4).ToList() ?? new List<ProductViewModel>();
                }
                @if (prods.Any())
                {
                    @foreach (var item in prods)
                    {
                        <div class="col-6 col-md-3">
                            <a asp-controller="Product" asp-action="Details" asp-route-id="@item.maSP" class="card-link">
                                <div class="product-card">
                                    <div class="product-img-wrapper">
                                        <img src="@item.hinhAnh" class="img-fluid" alt="@item.tenSP">
                                    </div>
                                    <h6 class="fw-bold text-truncate mb-2">@item.tenSP</h6>
                                    <p class="text-danger fw-bold mb-0">@item.giaBan.ToString("N0")₫</p>
                                </div>
                            </a>
                        </div>
                    }
                }
                else
                {
                    <div class="col-12">
                        <div class="text-center py-5 bg-white rounded-4 border">
                            <i class="bi bi-inbox fs-1 text-muted"></i>
                            <p class="text-muted">Sản phẩm đang được cập nhật...</p>
                        </div>
                    </div>
                }
            </div>
        </div>
    </section>
}

<section class="mt-5 mb-5">
    <div class="container">
        <div class="row g-3">
            <div class="col-md-3">
                <div class="d-flex align-items-center p-3 bg-white rounded-3 shadow-sm border">
                    <i class="bi bi-truck fs-2 text-danger me-3"></i>
                    <div>
                        <h6 class="mb-0 fw-bold">Giao hàng 2h</h6>
                        <small class="text-muted">Nội thành TP.HCM</small>
                    </div>
                </div>
            </div>
            <div class="col-md-3">
                <div class="d-flex align-items-center p-3 bg-white rounded-3 shadow-sm border">
                    <i class="bi bi-shield-check fs-2 text-danger me-3"></i>
                    <div>
                        <h6 class="mb-0 fw-bold">Bảo hành 12th</h6>
                        <small class="text-muted">Chính hãng 100%</small>
                    </div>
                </div>
            </div>
            <div class="col-md-3">
                <div class="d-flex align-items-center p-3 bg-white rounded-3 shadow-sm border">
                    <i class="bi bi-arrow-repeat fs-2 text-danger me-3"></i>
                    <div>
                        <h6 class="mb-0 fw-bold">Đổi trả 30 ngày</h6>
                        <small class="text-muted">Lỗi là đổi mới</small>
                    </div>
                </div>
            </div>
            <div class="col-md-3">
                <div class="d-flex align-items-center p-3 bg-white rounded-3 shadow-sm border">
                    <i class="bi bi-headset fs-2 text-danger me-3"></i>
                    <div>
                        <h6 class="mb-0 fw-bold">Hỗ trợ 24/7</h6>
                        <small class="text-muted">Hotline: 1900 xxxx</small>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>

<script>
    // Countdown Timer cải tiến
    function startCountdown() {
        const hEl = document.getElementById('h'), 
              mEl = document.getElementById('m'), 
              sEl = document.getElementById('s');
        
        if(!hEl) return;

        // Thiết lập thời gian kết thúc (ví dụ: 5h từ lúc load trang)
        let totalSeconds = 5 * 60 * 60 + 45 * 60 + 12;

        const timer = setInterval(() => {
            if (totalSeconds <= 0) {
                clearInterval(timer);
                return;
            }
            totalSeconds--;

            let h = Math.floor(totalSeconds / 3600);
            let m = Math.floor((totalSeconds % 3600) / 60);
            let s = totalSeconds % 60;

            hEl.innerText = h.toString().padStart(2, '0');
            mEl.innerText = m.toString().padStart(2, '0');
            sEl.innerText = s.toString().padStart(2, '0');
        }, 1000);
    }
    
    document.addEventListener('DOMContentLoaded', startCountdown);
</script>