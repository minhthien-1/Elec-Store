@model List<ElectronicsStore.API.Models.Entities.DonHang>
@{
    ViewData["Title"] = "Lịch sử mua hàng";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="container py-5">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h3 class="fw-bold"><i class="bi bi-receipt-cutoff me-2"></i>Lịch sử đơn hàng của tôi</h3>
        <a href="/" class="btn btn-outline-secondary btn-sm rounded-pill">
            <i class="bi bi-arrow-left me-1"></i> Quay lại mua sắm
        </a>
    </div>

    @if (Model != null && Model.Any())
    {
        <div class="row">
            @foreach (var order in Model)
            {
                <div class="col-12 mb-4">
                    <div class="card shadow-sm border-0 rounded-3 overflow-hidden">
                        <div class="card-header bg-white border-bottom py-3 d-flex justify-content-between align-items-center flex-wrap gap-2">
                            <div>
                                <span class="fw-bold text-primary me-2">#@order.MaDH</span>
                                <span class="text-muted small">@order.NgayTaoDon.ToString("dd/MM/yyyy HH:mm")</span>
                            </div>
                            <div>
                                @{
                                    string statusClass = order.TrangThaiDon switch
                                    {
                                        "Chờ xác nhận" => "bg-warning text-dark",
                                        "Đang giao hàng" => "bg-info text-white",
                                        "Hoàn thành" => "bg-success",
                                        "Đã hủy" => "bg-danger",
                                        _ => "bg-secondary"
                                    };
                                }
                                <span class="badge @statusClass rounded-pill me-2">@order.TrangThaiDon</span>

                                @if (order.TrangThaiThanhToan.Contains("Đã thanh toán"))
                                {
                                    <span class="badge bg-success bg-opacity-10 text-success border border-success rounded-pill">
                                        <i class="bi bi-check-circle-fill me-1"></i>Đã thanh toán
                                    </span>
                                }
                                else
                                {
                                    <span class="badge bg-secondary bg-opacity-10 text-secondary border border-secondary rounded-pill">
                                        Chưa thanh toán
                                    </span>
                                }
                            </div>
                        </div>

                        <div class="card-body p-0">
                            <div class="row g-0">
                                <div class="col-lg-8 border-end">
                                    <div class="p-3">
                                        @foreach (var item in order.ChiTietDonHangs)
                                        {
                                            <div class="d-flex align-items-center mb-3">
                                                <img src="@item.SanPham.HinhAnh" width="60" height="60" class="rounded border me-3" style="object-fit: cover;">
                                                <div class="flex-grow-1">
                                                    <h6 class="mb-0 fw-bold text-truncate">@item.SanPham.TenSP</h6>
                                                    <small class="text-muted">x @item.SoLuong</small>
                                                </div>
                                                <div class="text-end">
                                                    <span class="d-block fw-bold text-danger">@item.ThanhTien.ToString("N0")₫</span>
                                                    <small class="text-muted text-decoration-line-through">@item.GiaTaiThoiDiem.ToString("N0")₫</small>
                                                </div>
                                            </div>
                                        }
                                        <hr class="border-secondary border-opacity-10">
                                        <div class="d-flex justify-content-between align-items-center">
                                            <span class="text-muted">Tổng tiền:</span>
                                            <span class="fs-4 fw-bold text-danger">@order.TongGiaSauGiam.ToString("N0")₫</span>
                                        </div>
                                    </div>
                                </div>

                                <div class="col-lg-4 bg-light bg-opacity-50">
                                    <div class="p-3">
                                        <h6 class="fw-bold text-uppercase small text-muted mb-3">Tiến trình đơn hàng</h6>
                                        <div class="timeline-wrapper mb-4 ps-2 border-start border-2 border-primary">
                                            @foreach (var history in order.LichSuDonHangs.OrderByDescending(h => h.NgayCapNhat))
                                            {
                                                <div class="mb-3 ps-3 position-relative">
                                                    <div class="position-absolute top-0 start-0 translate-middle rounded-circle bg-primary" style="width: 10px; height: 10px; margin-left: -1px; margin-top: 6px;"></div>
                                                    <small class="d-block text-muted">@history.NgayCapNhat.ToString("dd/MM HH:mm")</small>
                                                    <span class="fw-bold d-block text-dark">@history.TrangThaiMoi</span>
                                                    @if (!string.IsNullOrEmpty(history.LyDo))
                                                    {
                                                        <small class="text-secondary fst-italic">"@history.LyDo"</small>
                                                    }
                                                </div>
                                            }
                                        </div>

                                        @if (order.LichSuThanhToans.Any())
                                        {
                                            <h6 class="fw-bold text-uppercase small text-muted mb-3 border-top pt-3">Giao dịch thanh toán</h6>
                                            @foreach (var trans in order.LichSuThanhToans)
                                            {
                                                <div class="bg-white p-2 rounded border mb-2 shadow-sm">
                                                    <div class="d-flex justify-content-between">
                                                        <span class="fw-bold small text-primary">@trans.PhuongThuc</span>
                                                        <span class="fw-bold small @(trans.TrangThaiGD == "Thành công" ? "text-success" : "text-danger")">
                                                            @trans.TrangThaiGD
                                                        </span>
                                                    </div>
                                                    <div class="d-flex justify-content-between mt-1">
                                                        <small class="text-muted">@trans.NgayThanhToan.ToString("HH:mm dd/MM")</small>
                                                        <small class="fw-bold text-dark">@trans.SoTienThanhToan.ToString("N0")₫</small>
                                                    </div>
                                                </div>
                                            }
                                        }
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            }
        </div>
    }
    else
    {
        <div class="text-center py-5">
            <img src="https://cdn-icons-png.flaticon.com/512/11458/11458212.png" width="120" class="opacity-50 mb-3">
            <h4 class="text-muted">Bạn chưa có đơn hàng nào</h4>
            <a href="/" class="btn btn-danger mt-3 rounded-pill px-4">Mua sắm ngay</a>
        </div>
    }
</div>