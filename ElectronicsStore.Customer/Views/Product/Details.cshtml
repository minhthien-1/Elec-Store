@model ElectronicsStore.Customer.Models.ViewModels.ProductDetailViewModel

@{
    ViewData["Title"] = Model.TenSP;
    Layout = "~/Views/Shared/_Layout.cshtml";

    int percentDiscount = 0;
    if (Model.GiaGiamGia.HasValue && Model.GiaBan > 0)
    {
        percentDiscount = (int)((1 - (Model.GiaGiamGia.Value / Model.GiaBan)) * 100);
    }
}

<style>
    /* CSS Cũ giữ nguyên */
    :root {
        --accent-red: #E31837;
        --dark-brown: #3E2723;
    }

    .product-detail-page {
        background-color: #f4f4f4;
        padding-bottom: 50px;
    }

    .white-box {
        background: #fff;
        border-radius: 16px;
        padding: 25px;
        box-shadow: 0 2px 15px rgba(0,0,0,0.05);
        margin-bottom: 20px; /* Tạo khoảng cách dưới mỗi box */
        height: 100%; /* Để các box trên cùng 1 hàng cao bằng nhau */
    }

    .main-image {
        width: 100%;
        border-radius: 12px;
        object-fit: contain;
        max-height: 500px;
    }

    .product-name h1 {
        font-size: 1.6rem;
        font-weight: 700;
        color: #333;
        margin-bottom: 10px;
    }

    .pro-price {
        color: var(--accent-red);
        font-size: 2rem;
        font-weight: 800;
    }

    .pro-percent {
        background: var(--accent-red);
        color: white;
        padding: 2px 8px;
        border-radius: 4px;
        margin-left: 10px;
    }

    .btn-buynow {
        background: linear-gradient(180deg, #ff424e, #e31837);
        color: white;
        border: none;
        padding: 12px;
        border-radius: 8px;
        font-weight: 700;
        width: 100%;
    }

    .section-title {
        font-size: 1.2rem;
        font-weight: 700;
        border-left: 4px solid var(--accent-red);
        padding-left: 15px;
        margin-bottom: 20px;
        text-transform: uppercase;
        border-bottom: 1px solid #eee; /* Thêm đường kẻ dưới tiêu đề */
        padding-bottom: 10px;
    }

    /* CSS Card sản phẩm tương tự */
    .similar-card {
        border: 1px solid #eee;
        border-radius: 12px;
        transition: 0.3s;
        background: #fff;
        display: block;
        text-decoration: none;
        color: inherit;
        height: 100%;
    }

        .similar-card:hover {
            transform: translateY(-5px);
            box-shadow: 0 5px 15px rgba(0,0,0,0.1);
            border-color: var(--accent-red);
        }

    .similar-img {
        width: 100%;
        height: 150px;
        object-fit: contain;
        padding: 10px;
    }

    /* CSS Đánh giá */
    .rating-select {
        width: 100%;
        border-radius: 8px; /* Bo góc vuông vức hơn tí cho hợp form */
        border: 1px solid #ced4da;
        padding: 10px;
        font-weight: 600;
        color: #E31837; /* Màu chữ đỏ cho nổi */
    }

    .avatar-circle {
        width: 50px;
        height: 50px;
        background-color: #f0f2f5;
        color: #333;
        font-weight: bold;
        display: flex;
        align-items: center;
        justify-content: center;
        border-radius: 50%;
        font-size: 1.2rem;
    }
</style>

<div class="product-detail-page">
    <div class="container py-4">

        <nav aria-label="breadcrumb" class="mb-3">
            <ol class="breadcrumb">
                <li class="breadcrumb-item"><a href="/" class="text-decoration-none text-muted">Trang chủ</a></li>
                <li class="breadcrumb-item active">@Model.TenSP</li>
            </ol>
        </nav>

        <div class="white-box">
            <div class="row">
                <div class="col-lg-5 col-md-12 mb-4 text-center">
                    <img src="@Model.HinhAnh" class="main-image" alt="@Model.TenSP" onerror="this.src='https://via.placeholder.com/600'">
                </div>
                <div class="col-lg-7 col-md-12 col-12 product-info">
                    <div class="info-wrapper">
                        <div class="product-name"><h1>@Model.TenSP</h1></div>
                        <div class="product-sku mb-2">
                            <span class="text-muted small">Thương hiệu: <strong class="text-danger">@Model.NhaSX?.TenNhaSX</strong></span>
                            <span class="text-muted small ms-3">Tình trạng: @(Model.SoLuongTonKho > 0 ? "Còn hàng" : "Hết hàng")</span>
                        </div>
                        <div class="product-rating mb-3">
                            <span class="text-warning">
                                @for (int i = 1; i <= 5; i++)
                                {
                                    <i class="bi @(i <= Math.Round(Model.DanhGiaXepHang) ? "bi-star-fill" : "bi-star")"></i>
                                }
                            </span>
                            <span class="small text-muted ms-2">(@Model.SoLuotDanhGia đánh giá)</span>
                        </div>
                        <div class="product-price mb-4">
                            @if (Model.GiaGiamGia.HasValue && Model.GiaGiamGia > 0)
                            {
                                <span class="pro-price">@Model.GiaGiamGia.Value.ToString("N0")₫</span>
                                <del class="text-muted ms-2">@Model.GiaBan.ToString("N0")₫</del>
                                <span class="pro-percent">-@percentDiscount%</span>
                            }
                            else
                            {
                                <span class="pro-price">@Model.GiaBan.ToString("N0")₫</span>
                            }
                        </div>
                        <div class="col-md-6 col-12">
                            <form action="/Cart/AddToCart" method="post" id="addToCartForm">
                                <input type="hidden" name="productId" value="@Model.MaSP" />
                                <input type="hidden" name="quantity" value="1" />
                                <button type="button" onclick="checkLoginAndBuy()" class="btn btn-buynow d-flex flex-column align-items-center">
                                    <span class="fs-5">ĐẶT HÀNG NGAY</span>
                                    <span style="font-size: 11px; font-weight: 400;">Giao tận nơi hoặc nhận tại cửa hàng</span>
                                </button>
                            </form>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <div class="row">
            <div class="col-lg-8 mb-4">
                <div class="white-box">
                    <h4 class="section-title">Đặc điểm nổi bật</h4>
                    <div class="product-desc-content p-2">
                        @Html.Raw(Model.MoTaChiTiet ?? "Đang cập nhật...")
                    </div>
                </div>
            </div>

            <div class="col-lg-4 mb-4">
                <div class="white-box">
                    <h4 class="section-title">Thông số kỹ thuật</h4>
                    <div class="specs-content p-2">
                        @Html.Raw(Model.ThongTinKyThuat ?? "Đang cập nhật...")
                    </div>
                </div>
            </div>
        </div>

        <div class="white-box mb-4">
            <h4 class="section-title">Sản phẩm tương tự</h4>
            @if (Model.SanPhamTuongTu != null && Model.SanPhamTuongTu.Any())
            {
                <div class="row g-3">
                    @foreach (var item in Model.SanPhamTuongTu)
                    {
                        <div class="col-lg-3 col-md-4 col-6">
                            <a asp-controller="Product" asp-action="Details" asp-route-id="@item.MaSP" class="similar-card p-3">
                                <div class="text-center">
                                    <img src="@item.HinhAnh" class="similar-img" onerror="this.src='https://via.placeholder.com/150'">
                                </div>
                                <div class="mt-2 text-center">
                                    <h6 class="fw-bold text-truncate small mb-1">@item.TenSP</h6>
                                    <p class="text-danger fw-bold mb-0">@item.GiaBan.ToString("N0") đ</p>
                                </div>
                            </a>
                        </div>
                    }
                </div>
            }
            else
            {
                <p class="text-muted text-center py-3">Chưa có sản phẩm tương tự.</p>
            }
        </div>

        <div class="white-box">
            <div class="row">
                <div class="col-md-4 border-end">
                    <h4 class="section-title">Gửi đánh giá của bạn</h4>

                    @if (User.Identity.IsAuthenticated)
                    {
                        <form asp-controller="Product" asp-action="SubmitReview" method="post" class="mt-3">
                            <input type="hidden" name="MaSP" value="@Model.MaSP" />

                            <div class="mb-3">
                                <label class="form-label fw-bold small text-uppercase text-muted">Mức độ hài lòng</label>
                                <select name="DemSao" class="form-select rating-select">
                                    <option value="5" selected>★★★★★ - Tuyệt vời</option>
                                    <option value="4">★★★★☆ - Hài lòng</option>
                                    <option value="3">★★★☆☆ - Bình thường</option>
                                    <option value="2">★★☆☆☆ - Tạm được</option>
                                    <option value="1">★☆☆☆☆ - Không thích</option>
                                </select>
                            </div>

                            <div class="mb-3">
                                <label class="form-label fw-bold small text-uppercase text-muted">Nội dung đánh giá</label>
                                <textarea name="NoiDung" class="form-control bg-light" rows="5" placeholder="Sản phẩm dùng thế nào? Hãy chia sẻ cảm nhận..." required style="border-radius: 8px;"></textarea>
                            </div>

                            <button type="submit" class="btn btn-danger w-100 fw-bold py-2 text-uppercase rounded-pill">
                                <i class="bi bi-send-fill me-2"></i> Gửi đánh giá
                            </button>
                        </form>
                    }
                    else
                    {
                        <div class="text-center py-5 bg-light rounded mt-3">
                            <i class="bi bi-person-circle fs-1 text-secondary"></i>
                            <p class="mt-2 fw-bold text-muted">Bạn cần đăng nhập để đánh giá</p>
                            <button class="btn btn-outline-danger btn-sm px-4 rounded-pill" data-bs-toggle="modal" data-bs-target="#loginModal">
                                Đăng nhập ngay
                            </button>
                        </div>
                    }
                </div>

                <div class="col-md-8 ps-md-4 mt-4 mt-md-0">
                    <h4 class="section-title d-flex justify-content-between align-items-center">
                        Khách hàng nhận xét
                        <span class="badge bg-secondary rounded-pill">@Model.SoLuotDanhGia</span>
                    </h4>

                    @if (Model.DanhGias != null && Model.DanhGias.Any())
                    {
                        <div class="review-list mt-3" style="max-height: 500px; overflow-y: auto; padding-right: 5px;">
                            @foreach (var review in Model.DanhGias)
                            {
                                <div class="d-flex gap-3 mb-4 border-bottom pb-3">
                                    <div class="flex-shrink-0">
                                        <div class="avatar-circle">
                                            @review.NguoiDung.TenDayDu.Substring(0, 1).ToUpper()
                                        </div>
                                    </div>
                                    <div class="flex-grow-1">
                                        <div class="d-flex justify-content-between align-items-center">
                                            <h6 class="fw-bold mb-0 text-dark">@review.NguoiDung.TenDayDu</h6>
                                            <small class="text-muted" style="font-size: 0.8rem;">
                                                <i class="bi bi-clock me-1"></i>@review.ThemTrongDB.ToString("dd/MM/yyyy HH:mm")
                                            </small>
                                        </div>

                                        <div class="text-warning small my-1">
                                            @for (int i = 0; i < review.DemSao; i++)
                                            {
                                                <i class="bi bi-star-fill"></i>
                                            }
                                            @for (int i = review.DemSao; i < 5; i++)
                                            {
                                                <i class="bi bi-star text-black-50 opacity-25"></i>
                                            }
                                        </div>

                                        <p class="mb-0 text-secondary mt-2" style="font-size: 0.95rem; line-height: 1.5;">@review.NoiDung</p>
                                    </div>
                                </div>
                            }
                        </div>
                    }
                    else
                    {
                        <div class="text-center py-5">
                            <img src="https://cdn-icons-png.flaticon.com/512/4076/4076432.png" width="80" class="opacity-50 mb-3" />
                            <p class="text-muted">Chưa có đánh giá nào cho sản phẩm này.<br>Hãy là người đầu tiên!</p>
                        </div>
                    }
                </div>
            </div>
        </div>

    </div>
</div>

<script>
    function checkLoginAndBuy() {
        var isLoggedIn = '@User.Identity.IsAuthenticated.ToString().ToLower()';
        if (isLoggedIn === 'true') {
            document.getElementById('addToCartForm').submit();
        } else {
            var myModal = new bootstrap.Modal(document.getElementById('loginModal'));
            myModal.show();
        }
    }
</script>