@model List<ElectronicsStore.API.Models.Entities.NhaSanXuat>

@if (Model != null && Model.Any())
{
    <section class="mt-5 mb-5">
        <div class="container">
            <div class="d-flex justify-content-between align-items-end mb-4">
                <h3 class="section-heading mb-0 border-start border-danger border-4 ps-3">Thương Hiệu Nổi Bật</h3>
            </div>
            <div class="row g-3 justify-content-center">
                @foreach (var brand in Model)
                {
                    <div class="col-4 col-md-2">
                        <a href="/Product?brandId=@brand.MaNhaSX" class="text-decoration-none">
                            <div class="card h-100 border shadow-sm align-items-center justify-content-center p-4 text-center rounded-4 transition-all brand-card">
                                <h6 class="fw-bold mb-0 text-dark">@brand.TenNhaSX</h6>
                            </div>
                        </a>
                    </div>
                }
            </div>
        </div>
        <style>
            .brand-card {
                transition: all 0.3s ease;
                background-color: white;
            }
            .brand-card:hover {
                transform: translateY(-5px);
                border-color: #D32F2F !important;
                background-color: #FFF5F5;
                box-shadow: 0 10px 20px rgba(211, 47, 47, 0.15) !important;
            }
        </style>
    </section>
}
