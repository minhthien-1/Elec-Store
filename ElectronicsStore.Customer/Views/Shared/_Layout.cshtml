<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Home Page</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <style>
        :root {
            --bg-cream: #F5F5DC;
            --bar-brown: #3E2723;
            --text-light: #ffffff;
        }
        body { background-color: var(--bg-cream); }
        .header-top, .footer-top { background-color: var(--bar-brown); color: var(--text-light); padding: 10px 0; }
        .sub-header-top { background-color: #5D4037; color: white; padding: 5px 0; }
        .footer-copyright { background-color: #1b1b1b; color: #ccc; padding: 10px 0; text-align: center; }
        .section-collection { margin: 20px 0; padding: 15px; border-bottom: 1px solid #ddd; }
        .header-top span, .sub-header-top span { margin-right: 15px; cursor: pointer; }
        .section-heading { font-weight: bold; font-size: 1.5rem; margin-bottom: 15px; color: var(--bar-brown); }
    </style>
</head>
<body>
    <header>
        <div class="banner text-center">
            <img src="" alt="Banner Top" />
        </div>
        <div class="main header-top">
            <div class="container d-flex align-items-center justify-content-between">
                <div class="logo">LOGO</div>
                <div class="category">Danh mục</div>
                <div class="search"><input type="text" placeholder="Tìm kiếm..." class="form-control" /></div>
                <div class="user-actions">
                    <span>Đăng nhập</span>
                    <span>Giỏ hàng</span>
                    <span>Tra cứu đơn</span>
                </div>
            </div>
        </div>
        <div class="sub-header-top">
            <div class="container d-flex justify-content-start">
                <span>Khuyến mãi</span>
                <span>Tin tức</span>
                <span>Hệ thống cửa hàng</span>
                <span>Liên hệ</span>
            </div>
        </div>
    </header>

    <main role="main">
        @RenderBody()
    </main>

    <footer>
        <div class="main footer-top">
            <div class="container">
                <p>Thông tin liên hệ & Chính sách</p>
            </div>
        </div>
        <div class="main footer-copyright">
            <div class="container">
                &copy; 2026 - Tên Cửa Hàng Của Bạn
            </div>
        </div>
    </footer>
</body>
</html>