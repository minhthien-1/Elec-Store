@model ElectronicsStore.Customer.Models.LoginViewModel

<style>
    /* ===== BIẾN MÀU VŨ TRỤ (CHUẨN THEO HÌNH) ===== */
    :root {
        --primary-purple: #8e2de2;
        --primary-blue: #4a00e0;
        --accent-cyan: #2bdce3;
        --dark-bg: #1a1c2e;
        --text-white: #ffffff;
        --btn-gradient: linear-gradient(90deg, #9d50bb 0%, #2bdce3 100%);
    }

    /* ===== BACKGROUND MODAL ===== */
    .modal-backdrop {
        background: rgba(10, 10, 20, 0.8) !important;
        backdrop-filter: blur(6px);
    }

    /* ===== MODAL CONTENT (FIX GÓC NHỌN & CHIỀU CAO) ===== */
    #loginModal .modal-content {
        background: var(--dark-bg);
        border-radius: 24px;
        overflow: hidden; /* Cắt mọi thành phần con bị lòi ra khỏi góc bo */
        border: 1px solid rgba(255, 255, 255, 0.1);
        box-shadow: 0 20px 50px rgba(0, 0, 0, 0.5), 0 0 20px rgba(124, 58, 237, 0.15);
        max-width: 420px;
        margin: auto;
        position: relative;
    }

        /* Hiệu ứng xung mạch nền nhẹ */
        #loginModal .modal-content::before {
            content: "";
            position: absolute;
            top: -50%;
            right: -50%;
            width: 200%;
            height: 200%;
            background: radial-gradient(circle, rgba(124, 58, 237, 0.05) 0%, transparent 70%);
            pointer-events: none;
            animation: pulse 4s ease-in-out infinite;
        }

    /* ===== MODAL HEADER (RÚT NGẮN) ===== */
    #loginModal .modal-header {
        background: linear-gradient(90deg, #8e2de2 0%, #4a00e0 100%);
        padding: 1rem 1.5rem !important; /* Rút ngắn chiều cao */
        border: none;
        display: flex;
        align-items: center;
        justify-content: space-between;
    }

    #loginModal .modal-title {
        color: var(--text-white);
        font-weight: 800;
        font-size: 1.2rem;
        letter-spacing: 1px;
        text-transform: uppercase;
        margin: 0;
    }

    #loginModal .btn-close {
        filter: brightness(0) invert(1);
        opacity: 0.8;
    }

    /* ===== MODAL BODY (CHỮ SÁNG & COMPACT) ===== */
    #loginModal .modal-body {
        padding: 1.5rem 2rem !important;
        background: rgba(15, 23, 42, 0.4);
    }

    #loginModal .mb-3 {
        margin-bottom: 0.8rem !important;
    }

    #loginModal .form-label {
        color: var(--text-white); /* Chữ trắng sáng */
        font-size: 0.85rem;
        font-weight: 700;
        margin-bottom: 0.5rem;
        text-transform: uppercase;
        display: block;
        opacity: 1;
    }

    /* ===== INPUT TRONG SUỐT ===== */
    .input-group-custom {
        background: rgba(255, 255, 255, 0.05);
        border: 1px solid rgba(255, 255, 255, 0.15);
        border-radius: 12px;
        transition: all 0.3s ease;
    }

        .input-group-custom:focus-within {
            border-color: var(--accent-cyan);
            box-shadow: 0 0 10px rgba(43, 220, 227, 0.3);
        }

        .input-group-custom .input-group-text {
            background: transparent;
            border: none;
            color: rgba(255, 255, 255, 0.6);
        }

        .input-group-custom .form-control {
            background: transparent;
            border: none;
            color: var(--text-white) !important;
            padding: 10px 0;
            font-size: 0.95rem;
        }

            .input-group-custom .form-control::placeholder {
                color: rgba(255, 255, 255, 0.3);
            }

    /* ===== NHỚ TÔI & QUÊN MẬT KHẨU ===== */
    .form-check-label {
        color: var(--text-white);
        font-size: 0.9rem;
    }

    .forgot-password-link {
        color: #ff6b9d !important;
        font-size: 0.85rem;
        font-weight: 500;
        text-decoration: none;
    }

    /* ===== NÚT ĐĂNG NHẬP (GIỐNG HÌNH 100%) ===== */
    .btn-login-main {
        background: var(--btn-gradient) !important;
        border: none !important;
        color: var(--text-white) !important;
        font-weight: 800;
        font-size: 1rem;
        padding: 12px !important;
        border-radius: 50px; /* Bo tròn kiểu viên thuốc */
        width: 100%;
        text-transform: uppercase;
        letter-spacing: 1.5px;
        margin-top: 10px;
        box-shadow: 0 5px 15px rgba(157, 80, 187, 0.4), 0 0 20px rgba(43, 220, 227, 0.2);
        transition: all 0.3s ease;
    }

        .btn-login-main:hover {
            transform: translateY(-2px);
            box-shadow: 0 8px 25px rgba(157, 80, 187, 0.6), 0 0 30px rgba(43, 220, 227, 0.4);
            filter: brightness(1.1);
        }

    /* ===== PHẦN "HOẶC" ===== */
    .divider-text {
        margin: 1.2rem 0;
        text-align: center;
        position: relative;
    }

        .divider-text::before {
            content: "";
            position: absolute;
            top: 50%;
            left: 0;
            width: 100%;
            height: 1px;
            background: rgba(255, 255, 255, 0.1);
            z-index: 0;
        }

        .divider-text span {
            background: var(--dark-bg);
            padding: 0 10px;
            color: rgba(255, 255, 255, 0.5);
            font-size: 0.85rem;
            position: relative;
            z-index: 1;
        }

    /* ===== NÚT SOCIAL ===== */
    .social-btn {
        border-radius: 12px;
        border: 1px solid rgba(255, 255, 255, 0.2) !important;
        color: var(--text-white) !important;
        background: transparent;
        padding: 8px !important;
        font-size: 0.9rem;
    }

    /* ===== MODAL FOOTER (KHÔNG CẦN CUỘN) ===== */
    #loginModal .modal-footer {
        background: rgba(0, 0, 0, 0.2);
        padding: 0.8rem !important;
        border-top: 1px solid rgba(255, 255, 255, 0.05);
        justify-content: center;
    }

        #loginModal .modal-footer .text-muted {
            color: rgba(255, 255, 255, 0.6) !important;
            font-size: 0.85rem;
        }

        #loginModal .modal-footer a {
            color: var(--accent-cyan) !important;
            font-weight: 700;
            text-decoration: none;
        }

    /* FIX Razor Animations */
    @@keyframes pulse {
        0%, 100% {
            opacity: 0.4;
        }

        50% {
            opacity: 0.8;
        }
    }

    @@media (max-width: 576px) {
        #loginModal .modal-content {
            margin: 10px;
        }
    }
</style>

<div class="modal fade" id="loginModal" tabindex="-1" aria-labelledby="loginModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">
            <div class="modal-header border-0">
                <h5 class="modal-title" id="loginModalLabel">ĐĂNG NHẬP TÀI KHOẢN</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">
                <form asp-controller="Account" asp-action="Login" method="post">
                    @Html.AntiForgeryToken()

                    <div class="mb-3">
                        <label class="form-label">Email hoặc số điện thoại</label>
                        <div class="input-group input-group-custom">
                            <span class="input-group-text"><i class="bi bi-envelope"></i></span>
                            <input asp-for="Email" class="form-control ps-0" placeholder="Nhập email của bạn" />
                        </div>
                        <span asp-validation-for="Email" class="text-danger small mt-1 d-block"></span>
                    </div>

                    <div class="mb-3">
                        <label class="form-label">Mật khẩu</label>
                        <div class="input-group input-group-custom">
                            <span class="input-group-text"><i class="bi bi-lock"></i></span>
                            <input asp-for="Password" type="password" class="form-control ps-0" id="passwordInput" placeholder="Nhập mật khẩu" />
                            <span class="input-group-text toggle-password-icon" onclick="togglePassword()" style="cursor: pointer;">
                                <i class="bi bi-eye-slash" id="toggleIcon"></i>
                            </span>
                        </div>
                        <span asp-validation-for="Password" class="text-danger small mt-1 d-block"></span>
                    </div>

                    <div class="d-flex justify-content-between align-items-center mb-3">
                        <div class="form-check">
                            <input class="form-check-input" type="checkbox" id="rememberCheck" />
                            <label class="form-check-label" for="rememberCheck">Nhớ tôi</label>
                        </div>
                        <a href="#" class="forgot-password-link">Quên mật khẩu?</a>
                    </div>

                    <button type="submit" class="btn btn-login-main">ĐĂNG NHẬP NGAY</button>

                    <div class="divider-text">
                        <span>hoặc đăng nhập bằng</span>
                    </div>

                    <div class="d-flex gap-3 w-100">
    <button type="submit" 
            name="provider" value="Google"
            asp-controller="Account" asp-action="ExternalLogin" 
            formnovalidate 
            class="btn btn-outline-danger w-50 social-btn">
        <i class="bi bi-google"></i> Google
    </button>

    <button type="submit" 
            name="provider" value="Facebook"
            asp-controller="Account" asp-action="ExternalLogin" 
            formnovalidate 
            class="btn btn-outline-primary w-50 social-btn">
        <i class="bi bi-facebook"></i> Facebook
    </button>
</div>
                </form>
            </div>
            <div class="modal-footer border-0">
                <span class="text-muted small">Bạn chưa có tài khoản?</span>
                <a href="javascript:void(0);"
                   class="text-decoration-none fw-bold"
                   style="color: var(--accent-cyan) !important;"
                   data-target-register>
                    Đăng ký ngay!
                </a>
            </div>
        </div>
    </div>
</div>

<script>
    document.addEventListener('DOMContentLoaded', function () {
        // Hàm chuyển đổi mượt mà giữa các Modal
        function switchModal(currentModalId, nextModalId) {
            const currentModalEl = document.querySelector(currentModalId);
            const currentModal = bootstrap.Modal.getOrCreateInstance(currentModalEl);

            currentModal.hide();

            currentModalEl.addEventListener('hidden.bs.modal', function () {
                const nextModalEl = document.querySelector(nextModalId);
                const nextModal = bootstrap.Modal.getOrCreateInstance(nextModalEl);
                nextModal.show();
            }, { once: true });
        }

        // Chuyển sang Register
        document.querySelectorAll('[data-target-register]').forEach(btn => {
            btn.addEventListener('click', () => switchModal('#loginModal', '#registerModal'));
        });

        // Chuyển sang Login
        document.querySelectorAll('[data-target-login]').forEach(btn => {
            btn.addEventListener('click', () => switchModal('#registerModal', '#loginModal'));
        });
    });

    function togglePassword() {
        const passwordInput = document.getElementById('passwordInput');
        const toggleIcon = document.getElementById('toggleIcon');
        if (passwordInput.type === 'password') {
            passwordInput.type = 'text';
            toggleIcon.classList.replace('bi-eye-slash', 'bi-eye');
        } else {
            passwordInput.type = 'password';
            toggleIcon.classList.replace('bi-eye', 'bi-eye-slash');
        }
    }
</script>